#include <windows.h>
#include "resource.h"
IDI_APP ICON "app.ico"
1 24 "app.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,4,1,0
 PRODUCTVERSION 1,4,1,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "ModernNotepad - text editor"
      VALUE "FileVersion", "1.4.1.0"
      VALUE "ProductName", "ModernNotepad"
      VALUE "ProductVersion", "1.4.1.0"
      VALUE "OriginalFilename", "ModernNotepad.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
